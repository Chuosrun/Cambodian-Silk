# Copy this file to `.env.local` and fill in the two real values.
# `.env.local` is already git-ignored — secrets never get committed.

# From Supabase → Project Settings → API:
#   Project URL  →  https://abcxyz.supabase.co   (ONLY the domain —
#                   no /rest/v1, no slashes at the end)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

#   Project API keys → "Publishable" key (starts with `sb_publishable_`).
#   The legacy "anon" key (eyJ…) is being retired — do NOT use it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: custom domain instead of the request's own origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000